#!/usr/bin/env bash
set -euo pipefail
python_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
command -v uv >/dev/null || { printf 'Missing uv; install it with the lab prerequisites or sudo pacman -S --needed uv.\n' >&2; exit 1; }
python_version=$(cat "$python_root/.python-version")
export UV_PYTHON="$python_version"
python_key=$(printf '%s' "$python_root" | sha256sum)
# Game checkouts may be on exFAT; environments need Unix symlinks.
export UV_PROJECT_ENVIRONMENT="${XDG_CACHE_HOME:-$HOME/.cache}/nes-static/python/${python_key:0:16}"
unset PYTHONHOME VIRTUAL_ENV
uv sync --quiet --project "$python_root" --managed-python --python "$python_version" --locked
export PYTHON="$UV_PROJECT_ENVIRONMENT/bin/python"
# Autoconf and upstream generators also discover Python through PATH.
export PATH="$(dirname -- "$PYTHON"):$PATH"
