#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/wayland-common"
bash "$root/tools/bootstrap-deps"
exec 9>"$NES_BUILD_DIR/setup.lock"
flock 9
[[ ! -f $wayland_prefix/complete ]] || { printf 'Wayland dependencies ready: %s\n' "$wayland_prefix"; exit 0; }
for tool in cc bison; do command -v "$tool" >/dev/null || die "Missing $tool; install the build prerequisites."; done
env -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_PATH pkg-config --exists expat || die 'Install Expat development files for the pinned Wayland scanner.'
mkdir -p "$wayland_work" "$NES_LOG_DIR/static"
log="$NES_LOG_DIR/static/bootstrap-wayland.log"
printf 'Wayland build log: %s\n' "$log"
exec > >(tee -a "$log") 2>&1
trap 'printf "Wayland build failed; see %s\n" "$log" >&2' ERR
while read -r checksum filename url; do
    [[ -n $checksum && $checksum != \#* ]] || continue
    archive="$NES_BUILD_DIR/downloads/$filename"
    if [[ ! -f $archive ]]; then
        curl --fail --location --retry 3 "$url" -o "$archive.part"
        printf '%s  %s\n' "$checksum" "$archive.part" | sha256sum -c -
        mv "$archive.part" "$archive"
    fi
    printf '%s  %s\n' "$checksum" "$archive" | sha256sum -c -
    directory=${filename%.tar.*}
    [[ $directory != xkbcommon-1.7.0 ]] || directory=libxkbcommon-xkbcommon-1.7.0
    if [[ ! -d $wayland_work/$directory ]]; then
        staging=$(mktemp -d "$wayland_work/extract.XXXXXX")
        tar -xf "$archive" -C "$staging"
        [[ -d $staging/$directory ]] || die "Unexpected archive root: $filename"
        mv "$staging/$directory" "$wayland_work/$directory"
        rmdir "$staging"
    fi
done < "$root/static/wayland.lock"
meson=(uv run --project "$root" meson)
# Build the pinned protocol generator for the build host, using its Expat.
if [[ ! -f $wayland_work/scanner.done ]]; then
    env -u PKG_CONFIG_LIBDIR -u PKG_CONFIG_PATH -u CC -u CXX -u CFLAGS -u LDFLAGS \
        "${meson[@]}" setup --reconfigure "$wayland_work/scanner-build" "$wayland_work/wayland-1.23.1" \
        --prefix="$wayland_prefix" --libdir=lib --buildtype=release \
        -Dlibraries=false -Dtests=false -Ddocumentation=false -Ddtd_validation=false
    ninja -C "$wayland_work/scanner-build"
    "${meson[@]}" install -C "$wayland_work/scanner-build"
    touch "$wayland_work/scanner.done"
fi
export CC="$prefix/bin/cc" AR=ar RANLIB=ranlib
export CFLAGS='-O2 -g0' LDFLAGS='-static'
export PKG_CONFIG_LIBDIR="$wayland_prefix/lib/pkgconfig:$prefix/lib/pkgconfig"
if [[ ! -f $wayland_work/ffi.done ]]; then
    # Wayland uses ffi_call; executable closure trampolines are unnecessary.
    (cd "$wayland_work/libffi-3.4.6"
     ./configure --host=x86_64-linux-musl --prefix="$wayland_prefix" --libdir="$wayland_prefix/lib" --disable-shared --enable-static --disable-docs --disable-exec-static-tramp
     make -j "${NES_BUILD_JOBS:-4}"
     make install)
    touch "$wayland_work/ffi.done"
fi
"$root/tools/prepare-build.py" wayland "$wayland_work/cross.ini" --cc "$CC"
cross=(--cross-file "$wayland_work/cross.ini" --prefix="$wayland_prefix" --libdir=lib --default-library=static --buildtype=release --wrap-mode=nodownload)
if [[ ! -f $wayland_work/client.done ]]; then
    "${meson[@]}" setup --reconfigure "$wayland_work/client-build" "$wayland_work/wayland-1.23.1" "${cross[@]}" \
        -Dscanner=false -Dtests=false -Ddocumentation=false -Ddtd_validation=false
    ninja -C "$wayland_work/client-build"
    "${meson[@]}" install -C "$wayland_work/client-build"
    touch "$wayland_work/client.done"
fi
if [[ ! -f $wayland_work/xkb.done ]]; then
    "${meson[@]}" setup --reconfigure "$wayland_work/xkb-build" "$wayland_work/libxkbcommon-xkbcommon-1.7.0" "${cross[@]}" \
        -Denable-tools=false -Denable-x11=false -Denable-wayland=false -Denable-xkbregistry=false \
        -Denable-docs=false -Denable-bash-completion=false -Dxkb-config-root=/usr/share/X11/xkb -Dxkb-config-extra-path=/etc/xkb -Dx-locale-root=/usr/share/X11/locale
    ninja -C "$wayland_work/xkb-build" libxkbcommon.a
    # Install only runtime library headers/archive; the upstream install also builds tests.
    mkdir -p "$wayland_prefix/include/xkbcommon"
    cp "$wayland_work/libxkbcommon-xkbcommon-1.7.0/include/xkbcommon/"*.h "$wayland_prefix/include/xkbcommon/"
    cp "$wayland_work/xkb-build/libxkbcommon.a" "$wayland_prefix/lib/"
    touch "$wayland_work/xkb.done"
fi
mkdir -p "$wayland_prefix/protocol"
protocol="$wayland_work/wayland-protocols-1.36/stable/xdg-shell/xdg-shell.xml"
"$wayland_prefix/bin/wayland-scanner" client-header "$protocol" "$wayland_prefix/protocol/xdg-shell.h"
"$wayland_prefix/bin/wayland-scanner" private-code "$protocol" "$wayland_prefix/protocol/xdg-shell.c"
for library in ffi wayland-client xkbcommon; do [[ -s $wayland_prefix/lib/lib$library.a ]] || die "Missing $library archive"; done
touch "$wayland_prefix/complete"
printf 'Wayland dependencies ready: %s\n' "$wayland_prefix"
