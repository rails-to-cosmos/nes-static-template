#!/usr/bin/env bash
source "$(dirname -- "${BASH_SOURCE[0]}")/wayland-common"
identity=$("$root/tools/manifest.py" value id)
bash "$root/tools/bootstrap-core"
bash "$root/tools/bootstrap-wayland"
exec 9>"$NES_BUILD_DIR/setup.lock"
flock 9
read -r revision checksum url < "$root/static/core.lock"
core_key=$(cat "$root/static/core.lock" "$root/tools/bootstrap-core" <(printf '%s' "$recipe_key") | sha256sum)
core="$NES_BUILD_DIR/core-${core_key:0:16}/libretro-fceumm-$revision"
mkdir -p "$NES_LOG_DIR/static" "$root/dist"
log="$NES_LOG_DIR/static/build.log"
inputs=$("$root/tools/manifest.py" inputs)
binary="$root/dist/$identity"
staging=$(mktemp -d "$NES_BUILD_DIR/game.XXXXXX")
trap 'rm -rf "$staging"' EXIT
"$root/tools/manifest.py" header "$staging" "$revision"

build_id=$(cat "$root/static/game.c" "$root/static/platform.c" "$root/static/platform-x11.c" "$root/static/platform-wayland.c" "$root/static/platform.h" \
    "$root/tools/build-game" "$staging/game-data.h" "$staging/game-identity.h" <(printf '%s' "$core_key$wayland_key") | sha256sum)
build_id=${build_id%% *}
if [[ -x $binary && -f $binary.build-id && $(cat "$binary.build-id") = "$build_id" ]]; then
    printf '%s\n' "$inputs" > "$binary.inputs-id"
    printf 'Game ready: %s\n' "$binary"
    exit 0
fi
printf 'Game build log: %s\n' "$log"
"$prefix/bin/cc" -std=c11 -O2 -g0 -static -s -Wall -Wextra -Werror \
    -DBUILD_ID="\"${build_id:0:16}\"" -I "$prefix/include" -I "$wayland_prefix/include" -I "$wayland_prefix/protocol" -I "$staging" \
    -I "$core/src/drivers/libretro/libretro-common/include" \
    "$root/static/game.c" "$root/static/platform.c" "$root/static/platform-x11.c" "$root/static/platform-wayland.c" \
    "$wayland_prefix/protocol/xdg-shell.c" "$core/fceumm.a" \
    -L "$prefix/lib" -L "$wayland_prefix/lib" -Wl,--start-group -lwayland-client -lffi -lxkbcommon -lxcb-shm -lxcb-xkb -lxcb -lXau -lpulse -lpulsecommon-17.0 -lsndfile \
    -Wl,--end-group -lm -pthread -o "$staging/game" >"$log" 2>&1 || {
        cat "$log" >&2; die "Build failed; see $log"
    }
if readelf -lW "$staging/game" | grep -q INTERP || readelf -dW "$staging/game" | grep -q NEEDED; then
    die 'Game unexpectedly depends on the dynamic loader.'
fi
"$staging/game" --version
[[ $("$root/tools/manifest.py" inputs) = "$inputs" ]] || die 'Sources changed during build; rerun make build.'
install -m 755 "$staging/game" "$binary.new"
mv -f "$binary.new" "$binary"
printf '%s\n' "$build_id" > "$binary.build-id"
printf '%s\n' "$inputs" > "$binary.inputs-id"
cp "$root/game.json" "$root/static/core.lock" "$root/static/sources.lock" "$root/static/wayland.lock" "$root/dist/"
mkdir -p "$root/dist/licenses"
for name in libXau-1.0.12 libxcb-1.17.0 xcb-proto-1.17.0 libsndfile-1.2.2; do
    cp "$work/$name/COPYING" "$root/dist/licenses/$name.txt"
done
cp "$core/Copying" "$root/dist/licenses/fceumm-GPL-2.0.txt"
cp "$work/pulseaudio-17.0/LICENSE" "$root/dist/licenses/pulseaudio-17.0.txt"
cp "$work/pulseaudio-17.0/LGPL" "$root/dist/licenses/LGPL-2.1.txt"
cp "$work/musl-1.2.5/COPYRIGHT" "$root/dist/licenses/musl.txt"
printf 'Built %s (%s bytes)\n' "$binary" "$(stat -c %s "$binary")"
cp "$wayland_work/wayland-1.23.1/COPYING" "$root/dist/licenses/wayland-1.23.1.txt"
cp "$wayland_work/libffi-3.4.6/LICENSE" "$root/dist/licenses/libffi-3.4.6.txt"
cp "$wayland_work/libxkbcommon-xkbcommon-1.7.0/LICENSE" "$root/dist/licenses/libxkbcommon-1.7.0.txt"
cp "$wayland_work/wayland-protocols-1.36/COPYING" "$root/dist/licenses/wayland-protocols-1.36.txt"
